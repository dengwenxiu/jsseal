{
  "name": "jsseal",
  "version": "0.5.0",
  "private": true,
  "description": "Deterministic sealed-runtime JavaScript deobfuscator (quickjs-ng fork, anchor-verified identity transforms)",
  "license": "MIT",
  "type": "commonjs",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:fixtures": "node tools/gen-fixtures.mjs",
    "cli": "node packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24.0.0",
    "javascript-obfuscator": "^4.1.0",
    "js-confuser": "^2.1.3",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "deobfuscator",
    "javascript",
    "quickjs",
    "reverse-engineering",
    "obfuscator-io",
    "security"
  ],
  "engines": {
    "node": ">=18"
  }
}
